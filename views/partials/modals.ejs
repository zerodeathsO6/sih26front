<!-- Reusable Modal Container -->
<div id="custom-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="modal-card">
    <div class="modal-header">
      <h3 id="modal-title" class="modal-title">Notification</h3>
      <button id="modal-x-btn" class="modal-close-btn" aria-label="Close modal">&times;</button>
    </div>
    <div class="modal-body">
      <p id="modal-message"></p>
    </div>
    <div class="modal-footer">
      <button id="modal-ok-btn" class="btn btn-primary">Understood</button>
    </div>
  </div>
</div>