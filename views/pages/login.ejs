<main style="flex: 1; display: flex; align-items: stretch; min-height: calc(100vh - 130px);">
    <div class="container"
        style="display: flex; gap: 32px; padding-block: 48px; width: 100%; align-items: center; justify-content: center; flex-wrap: wrap;">

        <!-- 1. Sidebar with Dynamic Progress Line -->
        <aside
            style="flex: 1; min-width: 280px; max-width: 320px; background-color: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 32px 24px; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 28px;">
            <div>
                <span class="metric-tag">Authentication Portal</span>
                <h3 style="font-size: 1.15rem; font-weight: 800; margin-top: 4px;">Secure Gateway</h3>
                <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 4px;">Complete the three verification
                    layers to access the NHAA portal.</p>
            </div>

            <!-- Stepper Container -->
            <div id="stepper-track-container"
                style="position: relative; display: flex; flex-direction: column; gap: 32px;">
                <!-- Base Track (Constrained strictly between Node 1 and Node 3 centers) -->
                <div
                    style="position: absolute; left: 15px; top: 16px; bottom: 16px; width: 2px; background-color: var(--border); z-index: 1;">
                </div>

                <!-- Active Filling Line (Constrained strictly between top and bottom node centers) -->
                <div
                    style="position: absolute; left: 15px; top: 16px; bottom: 16px; width: 2px; z-index: 2; pointer-events: none;">
                    <div id="progress-line-fill"
                        style="width: 100%; height: 0%; background-color: var(--primary); transition: height 0.35s ease;">
                    </div>
                </div>

                <!-- Step 1 Node -->
                <div id="sidebar-step-1" class="auth-step-item"
                    style="display: flex; align-items: center; gap: 14px; position: relative; z-index: 3; opacity: 1;">
                    <div class="step-dot"
                        style="width: 32px; height: 32px; border-radius: var(--radius-full); background: var(--primary); border: 2px solid var(--primary); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700; flex-shrink: 0; transition: all 0.3s ease;">
                        1
                    </div>
                    <div>
                        <h4 style="font-size: 0.9rem; font-weight: 700;">Account Identity</h4>
                        <p style="font-size: 0.75rem; color: var(--text-muted);">Registered email address</p>
                    </div>
                </div>

                <!-- Step 2 Node -->
                <div id="sidebar-step-2" class="auth-step-item"
                    style="display: flex; align-items: center; gap: 14px; position: relative; z-index: 3; opacity: 0.45; transition: opacity 0.3s ease;">
                    <div class="step-dot"
                        style="width: 32px; height: 32px; border-radius: var(--radius-full); background: var(--bg-surface); border: 2px solid var(--border); color: var(--text-muted); display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700; flex-shrink: 0; transition: all 0.3s ease;">
                        2
                    </div>
                    <div>
                        <h4 style="font-size: 0.9rem; font-weight: 700;">OTP Verification</h4>
                        <p style="font-size: 0.75rem; color: var(--text-muted);">One-time passcode</p>
                    </div>
                </div>

                <!-- Step 3 Node -->
                <div id="sidebar-step-3" class="auth-step-item"
                    style="display: flex; align-items: center; gap: 14px; position: relative; z-index: 3; opacity: 0.45; transition: opacity 0.3s ease;">
                    <div class="step-dot"
                        style="width: 32px; height: 32px; border-radius: var(--radius-full); background: var(--bg-surface); border: 2px solid var(--border); color: var(--text-muted); display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700; flex-shrink: 0; transition: all 0.3s ease;">
                        3
                    </div>
                    <div>
                        <h4 style="font-size: 0.9rem; font-weight: 700;">Portal Key</h4>
                        <p style="font-size: 0.75rem; color: var(--text-muted);">Master password</p>
                    </div>
                </div>
            </div>

            <!-- Security Guarantee Note -->
            <div
                style="background-color: var(--primary-light); border: 1px solid var(--primary-border); padding: 12px; border-radius: var(--radius-sm); font-size: 0.75rem; color: var(--primary); margin-top: auto;">
                🔒 Your data is always secure. <a onclick="window.open('/your-data', '_blank')" style="cursor: pointer;">Learn More</a>
            </div>
        </aside>

        <!-- 2. Interactive Form Container -->
        <section
            style="flex: 1; min-width: 300px; max-width: 480px; background-color: var(--bg-surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 36px 32px; box-shadow: var(--shadow-md);">

            <!-- Stage 1: Email -->
            <div id="stage-email">
                <div class="pill-badge" style="margin-bottom: 16px;">
                    <span class="pulsing-dot"></span>
                    Stage 1 of 3
                </div>
                <h2 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 6px;">Sign In to Sahayak</h2>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 24px;">Enter your registered
                    account email to begin. If you already have an account, use the same email.</p>

                <div style="display: flex; flex-direction: column; gap: 18px;">
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <label for="user-email"
                            style="font-size: 0.8rem; font-weight: 700; color: var(--text-main);">Email Address</label>
                        <input type="email" id="user-email" placeholder="officer@nhaa.gov.in"
                            style="width: 100%; padding: 12px 14px; border-radius: var(--radius-sm); border: 1px solid var(--border); background-color: var(--bg-subtle); color: var(--text-main); font-family: inherit; font-size: 0.9rem; outline: none;" />
                    </div>

                    <button type="button" id="btn-submit-email" class="btn btn-primary"
                        style="width: 100%; margin-top: 8px;">
                        Verify Email & Send OTP →
                    </button>
                </div>
            </div>

            <!-- Stage 2: OTP (Hidden) -->
            <div id="stage-otp" style="display: none;">
                <div class="pill-badge" style="margin-bottom: 16px;">
                    <span class="pulsing-dot"></span>
                    Stage 2 of 3
                </div>
                <h2 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 6px;">Enter Security Code</h2>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 24px;">Enter the 6-digit OTP sent
                    to your email.</p>

                <div style="display: flex; flex-direction: column; gap: 18px;">
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <label for="user-otp"
                            style="font-size: 0.8rem; font-weight: 700; color: var(--text-main);">One-Time Passcode
                            (OTP)</label>
                        <input type="text" id="user-otp" maxlength="6" placeholder="• • • • • •"
                            style="width: 100%; padding: 12px 14px; text-align: center; letter-spacing: 0.35em; font-weight: 700; font-size: 1.1rem; border-radius: var(--radius-sm); border: 1px solid var(--border); background-color: var(--bg-subtle); color: var(--text-main); font-family: inherit; outline: none;" />
                    </div>

                    <div style="display: flex; gap: 10px; margin-top: 8px;">
                        <button type="button" id="btn-back-to-email" class="btn btn-outline"
                            style="flex: 1;">Back</button>
                        <button type="button" id="btn-submit-otp" class="btn btn-primary" style="flex: 2;">Verify OTP
                            →</button>
                    </div>
                </div>
            </div>

            <!-- Stage 3: Password (Hidden with Strength Meter) -->
            <div id="stage-password" style="display: none;">
                <div class="pill-badge" style="margin-bottom: 16px;">
                    <span class="pulsing-dot"></span>
                    Stage 3 of 3
                </div>
                <h2 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 6px;">Enter Master Key</h2>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 24px;">Enter your portal password
                    to complete authentication.</p>

                <div style="display: flex; flex-direction: column; gap: 18px;">
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <label for="user-password"
                                style="font-size: 0.8rem; font-weight: 700; color: var(--text-main);">Password</label>
                            <span id="strength-label"
                                style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted); transition: color 0.2s;"></span>
                        </div>
                        <input type="password" id="user-password" placeholder="••••••••••••"
                            style="width: 100%; padding: 12px 14px; border-radius: var(--radius-sm); border: 1px solid var(--border); background-color: var(--bg-subtle); color: var(--text-main); font-family: inherit; font-size: 0.9rem; outline: none;" />
                        
                        <!-- Segmented Strength Meter Bar -->
                        <div style="display: flex; gap: 6px; margin-top: 4px;">
                            <div class="strength-bar"
                                style="flex: 1; height: 4px; border-radius: 2px; background-color: var(--border); transition: background-color 0.25s ease;">
                            </div>
                            <div class="strength-bar"
                                style="flex: 1; height: 4px; border-radius: 2px; background-color: var(--border); transition: background-color 0.25s ease;">
                            </div>
                            <div class="strength-bar"
                                style="flex: 1; height: 4px; border-radius: 2px; background-color: var(--border); transition: background-color 0.25s ease;">
                            </div>
                            <div class="strength-bar"
                                style="flex: 1; height: 4px; border-radius: 2px; background-color: var(--border); transition: background-color 0.25s ease;">
                            </div>
                        </div>
                    </div>

                    <div style="display: flex; gap: 10px; margin-top: 8px;">
                        <!-- <button type="button" id="btn-back-to-otp" class="btn btn-outline"
                            style="flex: 1;">Back</button> -->
                        <button type="button" id="btn-submit-login" class="btn btn-primary"
                            style="flex: 2;">Authenticate & Enter</button>
                    </div>
                </div>
            </div>

        </section>
    </div>
</main>

<!-- Unified Modal (used by showAlert) -->
<div class="modal-overlay" id="alertModal" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="modal-card">
        <div class="modal-header">
            <h3 class="modal-title" id="alertModalTitle">Notification</h3>
            <button class="modal-close-btn" id="closeAlertBtn" aria-label="Close modal">&times;</button>
        </div>
        <div class="modal-body" id="alertModalMessage"></div>
        <div class="modal-footer">
            <button class="btn btn-primary" id="confirmAlertBtn">Dismiss</button>
        </div>
    </div>
</div>